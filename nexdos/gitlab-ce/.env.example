# nexdos GitLab on Omnibus gitlab-ce, restored from the current (sameersbn) production.
# Copy to .env and fill in real values. .env is gitignored - never commit it.
# import-prod-env.sh fills the LDAP values and GITLAB_CE_VERSION from the running prod container.

# --- Image / container ---
# Must match the production sameersbn/gitlab version EXACTLY, or the backup restore fails.
GITLAB_CE_VERSION=19.5.0-ce.0
GITLAB_CONTAINER_NAME=gitlab-ce

# --- URLs (DNS must point at the nexdos host; Let's Encrypt certs are issued automatically) ---
# Test URLs for now. At cutover: git.nexdos.de / registry.nexdos.de.
GITLAB_HOST=git-staging.nexdos.de
GITLAB_REGISTRY_HOST=registry-staging.nexdos.de
LETSENCRYPT_EMAIL=

# --- SSH (the old instance uses 10022 - use a free port until cutover, then 10022) ---
GITLAB_SSH_PORT=20022

# --- Docker networks shared with the old instance (both already exist, external) ---
PROXY_NETWORK=proxy_network
LDAP_NETWORK=ldap

# --- LDAP (same directory as production; GitLab only ever binds/reads, never writes) ---
LDAP_LABEL=LDAP
LDAP_HOST=ldap.nexdos.de
LDAP_PORT=636
LDAP_ENCRYPTION=simple_tls
LDAP_VERIFY_CERTIFICATES=false
LDAP_UID=cn
LDAP_BIND_DN=cn=auth,dc=nexdos,dc=de
# Keep these single-quoted: the scripts also `source` this file in bash, where unquoted
# parentheses are a syntax error. The password must not itself contain a single quote.
LDAP_BIND_PASSWORD=''
LDAP_BASE=ou=users,dc=nexdos,dc=de
LDAP_USER_FILTER='(&(objectclass=*)(memberOf=cn=gitlab,ou=groups,dc=nexdos,dc=de))'
LDAP_ATTRIBUTE_USERNAME=uid
LDAP_ATTRIBUTE_MAIL=mail

# --- Email (SMTP values filled from prod by import-prod-env.sh) ---
# false while this is a test copy - it must never email real users. true at cutover.
EMAIL_ENABLED=false
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=''
SMTP_DOMAIN=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
GITLAB_EMAIL_FROM=
GITLAB_EMAIL_REPLY_TO=

# --- Backups / monitoring ---
# How long gitlab-backup keeps old tarballs in ./backups (seconds; 604800 = 7 days).
BACKUP_KEEP_TIME=604800
# Ping URL of the external monitor (healthchecks), like the old instance's healthcheck had.
# Leave EMPTY on the test copy; at cutover take it from the old instance's docker-compose.yml.
HC_PING_URL=

# --- Misc ---
GITLAB_TIME_ZONE=Berlin
# Keep RAM down while it shares the host with the old instance; raise/remove at cutover.
PUMA_WORKER_PROCESSES=2
SIDEKIQ_CONCURRENCY=10

# --- Clone script (clone-from-prod.sh) ---
PROD_GITLAB_CONTAINER=gitlab
PROD_REGISTRY_VOLUME=gitlab_registry-data
PROD_SECRETS_FILE=/home/git/gitlab/config/secrets.yml
BACKUP_DIR=./backups
# true  = test copy: disable cleanup policies, webhooks, integrations, mirrors, schedules
#         and show a TEST COPY banner, so it can't fire at real systems.
# false = real migration: keep everything active (this instance becomes production).
SANITIZE=true
# true = skip the registry image copy + import (everything else is still cloned).
SKIP_REGISTRY=true
# true  = restore an existing backup: one copied into BACKUP_DIR by hand, else prod's newest
#         nightly. Production is not modified at all.
# false = create a fresh backup on prod (live, ~1 min of extra load) - use this at cutover.
USE_EXISTING_BACKUP=true
