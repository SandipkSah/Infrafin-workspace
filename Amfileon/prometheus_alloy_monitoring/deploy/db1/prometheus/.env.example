# /srv/docker/prometheus/.env on db1 — staged by deploy/stage.sh; fill in the two empty values.

# bcrypt hashes of the alloyuser / grafana passwords; keep the single quotes
PROMETHEUS_ALLOYUSER_HASH='<bcrypt hash>'
PROMETHEUS_GRAFANA_HASH='<bcrypt hash>'
# plain grafana password: db1's Prometheus uses it to scrape itself and db2's Prometheus
GRAFANA_PROMETHEUS_PASSWORD=<password>

# who gets alert emails (later: the team address)
ALERT_EMAIL_TO=ssa@infrafin.de
# outgoing mail — the same account Watchtower uses (/srv/docker/watchtower/.env)
SMTP_SMARTHOST=mail.your-server.de:587
SMTP_FROM=amfileon@infrafin.net
SMTP_USERNAME=amfileon@infrafin.net
SMTP_PASSWORD=<fill in on db1>
# healthchecks.io check for the Watchdog heartbeat, e.g. https://hc-ping.com/<uuid>
HEALTHCHECKS_PING_URL=<fill in on db1>
