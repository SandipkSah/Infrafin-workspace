// Alloy on a Windows host (prod1, prod2) — the Windows counterpart of config/common.alloy + http.alloy.
// Installed by install-alloy-windows.ps1 (generated by gen_windows.py) as the Windows service "Alloy".
//
// No Docker / dockprom here: Alloy's built-in Windows exporter collects the host metrics, and the
// relabel rules below rename the core ones to the node-exporter names the dashboards and alert rules
// use (job="nodeexporter"), so the host appears in Fleet, Host detail, HostDown, HostDiskAlmostFull,
// HostMemoryLow like every Linux host. All other windows_* metrics are sent unchanged.
//
// Secrets are files readable only by SYSTEM and Administrators (C:\ProgramData\Amfileon\alloy).

local.file "alloy_password" {
  filename  = "C:\\ProgramData\\Amfileon\\alloy\\alloy_password"
  is_secret = true
}

local.file "alloy_http_password" {
  filename  = "C:\\ProgramData\\Amfileon\\alloy\\alloy_http_password"
  is_secret = true
}

// Alloy's own web server (the service listens on this host's LAN IP:12345, see the installer):
// UI and API need a login; /metrics and /-/ready stay open for db1's host-alive check.
http {
  auth {
    basic {
      username = "admin"
      password = local.file.alloy_http_password.content
    }
    filter {
      paths                       = ["/metrics", "/-/ready", "/-/healthy"]
      authenticate_matching_paths = false
    }
  }
}

prometheus.remote_write "both" {
  external_labels = { host = "__AMF_HOST__" }

  wal {
    max_keepalive_time = "24h"
  }

  endpoint {
    name = "db1"
    url  = "https://db1.prometheus.amf/api/v1/write"
    tls_config {
      ca_file = "C:\\ProgramData\\Amfileon\\alloy\\amfileon-ca.pem"
    }
    basic_auth {
      username = "alloyuser"
      password = local.file.alloy_password.content
    }
  }

  endpoint {
    name = "db2"
    url  = "https://db2.prometheus.amf/api/v1/write"
    tls_config {
      ca_file = "C:\\ProgramData\\Amfileon\\alloy\\amfileon-ca.pem"
    }
    basic_auth {
      username = "alloyuser"
      password = local.file.alloy_password.content
    }
  }
}

prometheus.exporter.windows "host" {
  enabled_collectors = ["cpu", "cs", "logical_disk", "memory", "net", "os", "process", "system"]

  // per-process memory/handles/threads, only for these (handover 2026-11-13: TimeBase's handle count
  // ~258k; the 11-12 OOM came from ~220k file readers). Processes that don't exist are simply absent.
  process {
    include = "(TimeBaseSvcLauncher|AggregatorSvcLauncher|StrategyServer.*|java|alloy)"
  }
}

prometheus.scrape "windows" {
  targets         = prometheus.exporter.windows.host.targets
  job_name        = "nodeexporter"
  scrape_interval = "15s"
  // the exporter is served by Alloy's own HTTP server, which requires the login (http block)
  basic_auth {
    username = "admin"
    password = local.file.alloy_http_password.content
  }
  forward_to = [prometheus.relabel.node_names.receiver]
}

// windows_* → node-exporter names for the metrics the dashboards and alert rules use
prometheus.relabel "node_names" {
  forward_to = [prometheus.remote_write.both.receiver]

  // job name like every Linux host (the exporter target would otherwise carry its own)
  rule {
    target_label = "job"
    replacement  = "nodeexporter"
  }
  // CPU: windows_cpu_time_total{core,mode} → node_cpu_seconds_total{cpu,mode}
  rule {
    source_labels = ["__name__"]
    regex         = "windows_cpu_time_total"
    target_label  = "__name__"
    replacement   = "node_cpu_seconds_total"
  }
  rule {
    source_labels = ["__name__", "core"]
    regex         = "node_cpu_seconds_total;(.+)"
    target_label  = "cpu"
    replacement   = "$1"
  }
  // memory
  rule {
    source_labels = ["__name__"]
    regex         = "windows_memory_available_bytes"
    target_label  = "__name__"
    replacement   = "node_memory_MemAvailable_bytes"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "windows_memory_physical_total_bytes|windows_cs_physical_memory_bytes"
    target_label  = "__name__"
    replacement   = "node_memory_MemTotal_bytes"
  }
  // disks: drive letters only (C:, D:, …); the hidden HarddiskVolumeN system partitions are dropped
  rule {
    source_labels = ["__name__", "volume"]
    regex         = "windows_logical_disk_(free|size)_bytes;HarddiskVolume.*"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "windows_logical_disk_free_bytes"
    target_label  = "__name__"
    replacement   = "node_filesystem_avail_bytes"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "windows_logical_disk_size_bytes"
    target_label  = "__name__"
    replacement   = "node_filesystem_size_bytes"
  }
  rule {
    source_labels = ["__name__", "volume"]
    regex         = "node_filesystem_(avail|size)_bytes;(.+)"
    target_label  = "mountpoint"
    replacement   = "$2"
  }
  rule {
    source_labels = ["__name__", "volume"]
    regex         = "node_filesystem_(avail|size)_bytes;(.+)"
    target_label  = "device"
    replacement   = "$2"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "node_filesystem_(avail|size)_bytes"
    target_label  = "fstype"
    replacement   = "ntfs"
  }
  // uptime
  rule {
    source_labels = ["__name__"]
    regex         = "windows_system_boot_time_timestamp"
    target_label  = "__name__"
    replacement   = "node_boot_time_seconds"
  }
}

// ================================================================================================
// Logs → Loki on db1 (https://db1.loki.amf, user "alloy"), the Windows counterpart of
// config/logs.alloy. Windows event logs:
//   System       all levels (service starts/stops, crashes, disk/driver errors, reboots)
//   Application  Critical, Error, Warning only (not every informational entry of every program)
// Each event is one JSON line (message, source, event_id, …). Labels: host, job="windows", channel,
// level. Secrets are redacted like on Linux; on the first start only the last 24 h are shipped.
// Read positions (bookmarks) live in Alloy's data folder, so a restart continues where it stopped.

local.file "loki_password" {
  filename  = "C:\\ProgramData\\Amfileon\\alloy\\loki_password"
  is_secret = true
}

loki.write "db1" {
  external_labels = { host = "__AMF_HOST__" }

  endpoint {
    url = "https://db1.loki.amf/loki/api/v1/push"
    tls_config {
      ca_file = "C:\\ProgramData\\Amfileon\\alloy\\amfileon-ca.pem"
    }
    basic_auth {
      username = "alloy"
      password = local.file.loki_password.content
    }
  }
}

loki.process "windows_events" {
  forward_to = [loki.write.db1.receiver]

  // first start: the event logs can hold months — ship only the last 24 h
  stage.drop {
    older_than          = "24h"
    drop_counter_reason = "older_than_24h"
  }
  // level label from the event's level NUMBER (the text is localised: "Fehler", "Warnung", … on
  // German Windows; it stays in the line as levelText) → the same names as the Linux journal
  // (crit, err, warning, info, debug), so {level="err"} finds errors on every host
  stage.json {
    expressions = { level_num = "level" }
  }
  stage.template {
    source   = "level"
    template = "{{ if eq .level_num \"1\" }}crit{{ else if eq .level_num \"2\" }}err{{ else if eq .level_num \"3\" }}warning{{ else if eq .level_num \"4\" }}info{{ else if eq .level_num \"5\" }}debug{{ else }}{{ .level_num }}{{ end }}"
  }
  stage.labels {
    values = { level = "" }
  }
  // same redaction as config/logs.alloy (only the value is replaced)
  stage.replace {
    expression = "(?i)(?:passw(?:or)?d|pwd|secret|token|api[_-]?key|access[_-]?key|private[_-]?key)[\"']?\\s*[:=]\\s*[\"']?([^\\s\"',;&}]+)"
    replace    = "<redacted>"
  }
  stage.replace {
    expression = "(?i)(?:authorization|proxy-authorization)[\"']?\\s*[:=]\\s*[\"']?(?:basic|bearer|token)\\s+([^\\s\"',;]+)"
    replace    = "<redacted>"
  }
  stage.replace {
    expression = "[a-zA-Z][a-zA-Z0-9+.-]*://[^:/@\\s]+:([^@/\\s]+)@"
    replace    = "<redacted>"
  }
}

loki.source.windowsevent "system" {
  eventlog_name          = "System"
  xpath_query            = "*"
  use_incoming_timestamp = true
  bookmark_path          = "C:\\ProgramData\\GrafanaLabs\\Alloy\\data\\bookmark-system.xml"
  labels                 = { job = "windows", channel = "System" }
  forward_to             = [loki.process.windows_events.receiver]
}

loki.source.windowsevent "application" {
  eventlog_name          = "Application"
  xpath_query            = "*[System[(Level=1 or Level=2 or Level=3)]]"
  use_incoming_timestamp = true
  bookmark_path          = "C:\\ProgramData\\GrafanaLabs\\Alloy\\data\\bookmark-application.xml"
  labels                 = { job = "windows", channel = "Application" }
  forward_to             = [loki.process.windows_events.receiver]
}
