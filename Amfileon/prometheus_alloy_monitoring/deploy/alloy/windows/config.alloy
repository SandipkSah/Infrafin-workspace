// Alloy on a Windows host (prod2) — the Windows counterpart of config/common.alloy + http.alloy.
// Installed by install-alloy-windows.ps1 (generated by gen_windows.py) as the Windows service "Alloy".
//
// No Docker / dockprom here: Alloy's built-in Windows exporter collects the host metrics, and the
// relabel rules below rename the core ones to the node-exporter names the dashboards and alert rules
// use (job="nodeexporter"), so the host appears in Fleet, Host detail, HostDown, HostDiskAlmostFull,
// HostMemoryLow like every Linux host. All other windows_* metrics are sent unchanged.
//
// Secrets are files readable only by SYSTEM and Administrators (C:\ProgramData\Amfileon\alloy).

local.file "alloy_password" {
  filename  = "C:\\ProgramData\\Amfileon\\alloy\\alloy_password"
  is_secret = true
}

local.file "alloy_http_password" {
  filename  = "C:\\ProgramData\\Amfileon\\alloy\\alloy_http_password"
  is_secret = true
}

// Alloy's own web server (the service listens on this host's LAN IP:12345, see the installer):
// UI and API need a login; /metrics and /-/ready stay open for db1's host-alive check.
http {
  auth {
    basic {
      username = "admin"
      password = local.file.alloy_http_password.content
    }
    filter {
      paths                       = ["/metrics", "/-/ready", "/-/healthy"]
      authenticate_matching_paths = false
    }
  }
}

prometheus.remote_write "both" {
  external_labels = { host = "__AMF_HOST__" }

  wal {
    max_keepalive_time = "24h"
  }

  endpoint {
    name = "db1"
    url  = "https://db1.prometheus.amf/api/v1/write"
    tls_config {
      ca_file = "C:\\ProgramData\\Amfileon\\alloy\\amfileon-ca.pem"
    }
    basic_auth {
      username = "alloyuser"
      password = local.file.alloy_password.content
    }
  }

  endpoint {
    name = "db2"
    url  = "https://db2.prometheus.amf/api/v1/write"
    tls_config {
      ca_file = "C:\\ProgramData\\Amfileon\\alloy\\amfileon-ca.pem"
    }
    basic_auth {
      username = "alloyuser"
      password = local.file.alloy_password.content
    }
  }
}

prometheus.exporter.windows "host" {
  enabled_collectors = ["cpu", "cs", "logical_disk", "memory", "net", "os", "system"]
}

prometheus.scrape "windows" {
  targets         = prometheus.exporter.windows.host.targets
  job_name        = "nodeexporter"
  scrape_interval = "15s"
  // the exporter is served by Alloy's own HTTP server, which requires the login (http block)
  basic_auth {
    username = "admin"
    password = local.file.alloy_http_password.content
  }
  forward_to = [prometheus.relabel.node_names.receiver]
}

// windows_* → node-exporter names for the metrics the dashboards and alert rules use
prometheus.relabel "node_names" {
  forward_to = [prometheus.remote_write.both.receiver]

  // job name like every Linux host (the exporter target would otherwise carry its own)
  rule {
    target_label = "job"
    replacement  = "nodeexporter"
  }
  // CPU: windows_cpu_time_total{core,mode} → node_cpu_seconds_total{cpu,mode}
  rule {
    source_labels = ["__name__"]
    regex         = "windows_cpu_time_total"
    target_label  = "__name__"
    replacement   = "node_cpu_seconds_total"
  }
  rule {
    source_labels = ["__name__", "core"]
    regex         = "node_cpu_seconds_total;(.+)"
    target_label  = "cpu"
    replacement   = "$1"
  }
  // memory
  rule {
    source_labels = ["__name__"]
    regex         = "windows_memory_available_bytes"
    target_label  = "__name__"
    replacement   = "node_memory_MemAvailable_bytes"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "windows_memory_physical_total_bytes|windows_cs_physical_memory_bytes"
    target_label  = "__name__"
    replacement   = "node_memory_MemTotal_bytes"
  }
  // disks: drive letters only (C:, D:, …); the hidden HarddiskVolumeN system partitions are dropped
  rule {
    source_labels = ["__name__", "volume"]
    regex         = "windows_logical_disk_(free|size)_bytes;HarddiskVolume.*"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "windows_logical_disk_free_bytes"
    target_label  = "__name__"
    replacement   = "node_filesystem_avail_bytes"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "windows_logical_disk_size_bytes"
    target_label  = "__name__"
    replacement   = "node_filesystem_size_bytes"
  }
  rule {
    source_labels = ["__name__", "volume"]
    regex         = "node_filesystem_(avail|size)_bytes;(.+)"
    target_label  = "mountpoint"
    replacement   = "$2"
  }
  rule {
    source_labels = ["__name__", "volume"]
    regex         = "node_filesystem_(avail|size)_bytes;(.+)"
    target_label  = "device"
    replacement   = "$2"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "node_filesystem_(avail|size)_bytes"
    target_label  = "fstype"
    replacement   = "ntfs"
  }
  // uptime
  rule {
    source_labels = ["__name__"]
    regex         = "windows_system_boot_time_timestamp"
    target_label  = "__name__"
    replacement   = "node_boot_time_seconds"
  }
}
