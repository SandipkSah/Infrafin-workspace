prometheus.scrape "redis" {
  targets         = array.concat(discovery.relabel.redis_production_prod4.output, discovery.relabel.redis_sentinel_production_prod4.output, discovery.relabel.redis_sentinel_staging.output, discovery.relabel.redis_mktdata_staging.output, discovery.relabel.redis_nexdos_staging.output, discovery.relabel.redis_GSIND_PAPER_TRADING.output)
  scrape_interval = "30s"
  // the exporters are served by Alloy's own HTTP server, which requires the login (http.alloy)
  basic_auth {
    username = "admin"
    password = sys.env("ALLOY_HTTP_PASSWORD")
  }
  forward_to = [prometheus.remote_write.both.receiver]
}
