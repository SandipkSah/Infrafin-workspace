// GENERATED by alloy/gen_services.py from service-targets.txt — edit that file instead.
// prod4: 9 of 13 listed ClickHouse/Redis/GitLab targets switched on.

// ── ClickHouse: built-in Prometheus endpoint (:9363) of each server and keeper ─────────────────
prometheus.scrape "clickhouse" {
  job_name        = "clickhouse"
  targets         = [
    { "__address__" = "prod4.production.marketdata.ch.amf:9363", "clickhouse" = "prod4.production.marketdata.ch.amf", "cluster" = "marketdata-production", "role" = "server" },
    { "__address__" = "prod4.staging.ch.amf:9363", "clickhouse" = "prod4.staging.ch.amf", "cluster" = "staging", "role" = "server" },
    { "__address__" = "prod4.staging.marketdata.ch.amf:9363", "clickhouse" = "prod4.staging.marketdata.ch.amf", "cluster" = "marketdata-staging", "role" = "server" },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.clickhouse.receiver]
}

// per-CPU / per-disk / per-NIC copies of host metrics (node-exporter already has them) and the
// latency histograms — not used by any dashboard or alert
prometheus.relabel "clickhouse" {
  forward_to = [prometheus.remote_write.both.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "ClickHouseHistogramMetrics_.*|ClickHouseAsyncMetrics_(OS[A-Za-z]+CPU[0-9]+|CPUFrequencyMHz_[0-9]+|Block[A-Za-z]+_.+|Network(Receive|Send)[A-Za-z]+_.+|Temperature.*)"
    action        = "drop"
  }
}


// ── Redis: Alloy's built-in redis exporter, one per instance ─────────────────────────────────────

prometheus.exporter.redis "redis_production_prod4" {
  redis_addr       = "rediss://production.redis.amf:46379"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_PRODUCTION_PROD4")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

discovery.relabel "redis_production_prod4" {
  targets = prometheus.exporter.redis.redis_production_prod4.targets
  rule {
    target_label = "redis"
    replacement  = "redis-production-prod4"
  }
  rule {
    target_label = "cluster"
    replacement  = "production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "server"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.exporter.redis "redis_sentinel_production_prod4" {
  redis_addr       = "rediss://production.redis.amf:46380"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_SENTINEL_PRODUCTION_PROD4")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

