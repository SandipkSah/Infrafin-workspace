// GENERATED by alloy/gen_services.py from service-targets.txt — edit that file instead.
// db1: 10 of 12 listed ClickHouse/Redis/GitLab targets switched on.

// ── ClickHouse: built-in Prometheus endpoint (:9363) of each server and keeper ─────────────────
prometheus.scrape "clickhouse" {
  job_name        = "clickhouse"
  targets         = [
    { "__address__" = "db1.production.ch.amf:9363", "clickhouse" = "db1.production.ch.amf", "cluster" = "production", "role" = "server" },
    { "__address__" = "db1.staging.ch.amf:9363", "clickhouse" = "db1.staging.ch.amf", "cluster" = "staging", "role" = "server" },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.clickhouse.receiver]
}

// per-CPU / per-disk / per-NIC copies of host metrics (node-exporter already has them) and the
// latency histograms — not used by any dashboard or alert
prometheus.relabel "clickhouse" {
  forward_to = [prometheus.remote_write.both.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "ClickHouseHistogramMetrics_.*|ClickHouseAsyncMetrics_(OS[A-Za-z]+CPU[0-9]+|CPUFrequencyMHz_[0-9]+|Block[A-Za-z]+_.+|Network(Receive|Send)[A-Za-z]+_.+|Temperature.*)"
    action        = "drop"
  }
}


// ── Redis: Alloy's built-in redis exporter, one per instance ─────────────────────────────────────

prometheus.exporter.redis "redis_production_db1" {
  redis_addr       = "rediss://production.redis.amf:46379"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_PRODUCTION_DB1")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

discovery.relabel "redis_production_db1" {
  targets = prometheus.exporter.redis.redis_production_db1.targets
  rule {
    target_label = "redis"
    replacement  = "redis-production-db1"
  }
  rule {
    target_label = "cluster"
    replacement  = "production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "server"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.exporter.redis "redis_sentinel_production_db1" {
  redis_addr       = "rediss://production.redis.amf:46380"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_SENTINEL_PRODUCTION_DB1")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

discovery.relabel "redis_sentinel_production_db1" {
  targets = prometheus.exporter.redis.redis_sentinel_production_db1.targets
  rule {
    target_label = "redis"
    replacement  = "redis-sentinel-production-db1"
  }
  rule {
    target_label = "cluster"
    replacement  = "production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "sentinel"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.exporter.redis "redis_staging" {
  redis_addr       = "rediss://db1.redis.amf:26379"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_STAGING")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

discovery.relabel "redis_staging" {
  targets = prometheus.exporter.redis.redis_staging.targets
  rule {
    target_label = "redis"
    replacement  = "redis-staging"
  }
  rule {
    target_label = "cluster"
    replacement  = "staging"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "server"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.exporter.redis "redis_sentinel_staging" {
  redis_addr       = "rediss://db1.redis.amf:26380"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_SENTINEL_STAGING")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

discovery.relabel "redis_sentinel_staging" {
  targets = prometheus.exporter.redis.redis_sentinel_staging.targets
  rule {
    target_label = "redis"
    replacement  = "redis-sentinel-staging"
  }
  rule {
    target_label = "cluster"
    replacement  = "staging"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "sentinel"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.scrape "redis" {
  targets         = array.concat(discovery.relabel.redis_production_db1.output, discovery.relabel.redis_sentinel_production_db1.output, discovery.relabel.redis_staging.output, discovery.relabel.redis_sentinel_staging.output)
  scrape_interval = "30s"
  // the exporters are served by Alloy's own HTTP server, which requires the login (http.alloy)
  basic_auth {
    username = "admin"
    password = sys.env("ALLOY_HTTP_PASSWORD")
  }
  forward_to = [prometheus.remote_write.both.receiver]
}


// ── GitLab: Puma, Workhorse, Sidekiq and gitlab-exporter metrics ports inside the container ────
prometheus.scrape "gitlab" {
  targets         = [
    { "__address__" = "gitlab-ee:8083", "__metrics_path__" = "/metrics", "job" = "gitlab-puma", "gitlab" = "gitlab-ee" },
    { "__address__" = "gitlab-ee:9229", "__metrics_path__" = "/metrics", "job" = "gitlab-workhorse", "gitlab" = "gitlab-ee" },
    { "__address__" = "gitlab-ee:8082", "__metrics_path__" = "/metrics", "job" = "gitlab-sidekiq", "gitlab" = "gitlab-ee" },
    { "__address__" = "gitlab-ee:9168", "__metrics_path__" = "/sidekiq", "job" = "gitlab-exporter", "gitlab" = "gitlab-ee" },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.gitlab.receiver]
}

// Drops ~80 % of GitLab's series that no dashboard uses (measured in services-rehearsal/:
// 16 300 → ~3 000): the SLI counters GitLab pre-creates for every endpoint and GraphQL query
// (gitlab_sli_*), per-worker Sidekiq concurrency limits, histograms and _sum, Rails/SQL latency histograms and the
// Workhorse size histograms. Kept: request counts/latency (Workhorse), Puma, Sidekiq job counts.
prometheus.relabel "gitlab" {
  forward_to = [prometheus.remote_write.both.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "gitlab_sli_.*|gitlab_ruby_threads_.*|sidekiq_concurrency_limit_.*|loose_foreign_key_.*|sidekiq_.*_bucket|sidekiq_jobs_completion_seconds_sum|(gitlab_sql|gitlab_sql_primary|gitlab_transaction|gitlab_redis_client_requests|http_request)_duration_seconds_bucket|gitlab_workhorse_http_(request|response)_size_bytes_bucket|gitlab_workhorse_http_time_to_write_header_seconds_bucket"
    action        = "drop"
  }
}
