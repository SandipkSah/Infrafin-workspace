// cpu2 — exporters specific to this host (in addition to common.alloy).
// Mirrors the scrape jobs of /srv/docker/dockprom/prometheus/prometheus-customized.yaml on cpu2.

prometheus.scrape "scaphandre" {
  job_name        = "scaphandre"
  targets         = [{ "__address__" = "scaphandre:8080" }]
  // scaphandre is slow on busy hosts (≈9s on db2): power data every 60s is plenty
  scrape_interval = "60s"
  scrape_timeout  = "30s"
  forward_to      = [prometheus.relabel.scaphandre_host_level.receiver]
}
