// gpu1 — exporters specific to this host (in addition to common.alloy).
// Mirrors the scrape jobs of /srv/docker/dockprom/prometheus/prometheus-customized.yaml on gpu1.

prometheus.scrape "scaphandre" {
  job_name        = "scaphandre"
  targets         = [{ "__address__" = "scaphandre:8080" }]
  // scaphandre is slow on busy hosts (≈9s on db2): power data every 60s is plenty
  scrape_interval = "60s"
  scrape_timeout  = "30s"
  forward_to      = [prometheus.relabel.scaphandre_host_level.receiver]
}

prometheus.scrape "nvidia_dcg_export" {
  job_name        = "nvidia_dcg_export"
  targets         = [{ "__address__" = "nvidia-dcg:9400" }]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.both.receiver]
}
