  }
  rule {
    target_label = "cluster"
    replacement  = "marketdata-production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "server"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.exporter.redis "redis_GSIND_PROD" {
  redis_addr     = "10.10.10.13:6381"
  redis_password = sys.env("REDIS_PASSWORD_REDIS_GSIND_PROD")   // from redis.env; empty = no password
}

discovery.relabel "redis_GSIND_PROD" {
  targets = prometheus.exporter.redis.redis_GSIND_PROD.targets
  rule {
    target_label = "redis"
    replacement  = "redis-GSIND_PROD"
  }
  rule {
    target_label = "cluster"
    replacement  = "gsind-production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "server"
  }
  rule {
