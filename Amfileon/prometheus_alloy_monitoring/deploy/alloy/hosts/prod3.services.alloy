// GENERATED by alloy/gen_services.py from service-targets.txt — edit that file instead.
// prod3: 7 of 10 listed ClickHouse/Redis/GitLab targets switched on.

// ── ClickHouse: built-in Prometheus endpoint (:9363) of each server and keeper ─────────────────
prometheus.scrape "clickhouse" {
  job_name        = "clickhouse"
  targets         = [
    { "__address__" = "prod3.production.ch.amf:9363", "clickhouse" = "prod3.production.ch.amf", "cluster" = "production", "role" = "server" },
    { "__address__" = "prod3.production.marketdata.ch.amf:9363", "clickhouse" = "prod3.production.marketdata.ch.amf", "cluster" = "marketdata-production", "role" = "server" },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.clickhouse.receiver]
}

// per-CPU / per-disk / per-NIC copies of host metrics (node-exporter already has them) and the
// latency histograms — not used by any dashboard or alert
prometheus.relabel "clickhouse" {
  forward_to = [prometheus.remote_write.both.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "ClickHouseHistogramMetrics_.*|ClickHouseAsyncMetrics_(OS[A-Za-z]+CPU[0-9]+|CPUFrequencyMHz_[0-9]+|Block[A-Za-z]+_.+|Network(Receive|Send)[A-Za-z]+_.+|Temperature.*)"
    action        = "drop"
  }
}


// ── Redis: Alloy's built-in redis exporter, one per instance ─────────────────────────────────────

prometheus.exporter.redis "redis_production_prod3" {
  redis_addr       = "rediss://production.redis.amf:46379"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_PRODUCTION_PROD3")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

discovery.relabel "redis_production_prod3" {
  targets = prometheus.exporter.redis.redis_production_prod3.targets
  rule {
    target_label = "redis"
    replacement  = "redis-production-prod3"
  }
  rule {
    target_label = "cluster"
    replacement  = "production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "server"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.exporter.redis "redis_sentinel_production_prod3" {
  redis_addr       = "rediss://production.redis.amf:46380"
  redis_password   = sys.env("REDIS_PASSWORD_REDIS_SENTINEL_PRODUCTION_PROD3")   // from redis.env; empty = no password
  tls_ca_cert_file = "/etc/alloy-ca/amfileon-ca.pem"
}

discovery.relabel "redis_sentinel_production_prod3" {
  targets = prometheus.exporter.redis.redis_sentinel_production_prod3.targets
  rule {
    target_label = "redis"
    replacement  = "redis-sentinel-production-prod3"
  }
  rule {
    target_label = "cluster"
    replacement  = "production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "sentinel"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.exporter.redis "redis_mktdata_production" {
  redis_addr     = "10.10.10.13:6382"
  redis_password = sys.env("REDIS_PASSWORD_REDIS_MKTDATA_PRODUCTION")   // from redis.env; empty = no password
}

discovery.relabel "redis_mktdata_production" {
  targets = prometheus.exporter.redis.redis_mktdata_production.targets
  rule {
    target_label = "redis"
