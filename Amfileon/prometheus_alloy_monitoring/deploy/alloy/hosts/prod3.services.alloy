prometheus.exporter.redis "redis_production" {
  redis_addr     = "10.10.10.13:6379"
  redis_password = sys.env("REDIS_PASSWORD_REDIS_PRODUCTION")   // from redis.env; empty = no password
}

discovery.relabel "redis_production" {
  targets = prometheus.exporter.redis.redis_production.targets
  rule {
    target_label = "redis"
    replacement  = "redis-production"
  }
  rule {
    target_label = "cluster"
    replacement  = "trading-production"
  }
  rule {
    target_label = "kind"     // server|sentinel ("role" is the exporter's master/slave label)
    replacement  = "server"
  }
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

prometheus.scrape "redis" {
  targets         = array.concat(discovery.relabel.redis_production_prod3.output, discovery.relabel.redis_sentinel_production_prod3.output, discovery.relabel.redis_mktdata_production.output, discovery.relabel.redis_GSIND_PROD.output, discovery.relabel.redis_production.output)
  scrape_interval = "30s"
  // the exporters are served by Alloy's own HTTP server, which requires the login (http.alloy)
  basic_auth {
    username = "admin"
    password = sys.env("ALLOY_HTTP_PASSWORD")
  }
  forward_to = [prometheus.remote_write.both.receiver]
}
