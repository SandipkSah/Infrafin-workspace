# /srv/docker/alloy/.env — written per host by deploy/stage-alloy.sh.
ALLOY_PASSWORD=<password from deploy/secrets/alloy.env>
ALLOY_HTTP_PASSWORD=<password from deploy/secrets/alloy.env>   # Alloy UI login, user admin
# value of the `host` label on every series from this machine
AMF_HOST=cpu1
# LAN IP that Alloy's port 12345 is published on (db1 checks it for HostDown)
AMF_HOST_IP=10.10.10.30
