{
  "uid": "amf-fleet",
  "title": "Fleet overview",
  "description": "All Amfileon hosts at a glance.",
  "tags": [
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "Prometheus-db.*",
        "current": {
          "text": "Prometheus-db1",
          "value": "prom-db1"
        },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hosts reachable (db1)",
      "description": "db1 checks every host's Alloy agent every 15 s (host-alive). DOWN = host or agent unreachable \u2192 HostDown alert after 2 min. Always read from Prometheus-db1: only db1 runs these checks; db2 only stores a copy of the hosts' metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-db1"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-db1"
          },
          "expr": "up{job=\"host-alive\"}",
          "legendFormat": "{{host}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d03b3b"
              },
              {
                "value": 1,
                "color": "#0ca30c"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#d03b3b"
                },
                "1": {
                  "text": "UP",
                  "color": "#0ca30c"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerts firing (db1)",
      "description": "Firing alerts (Watchdog excluded). Details: 'Monitoring health' dashboard. Always read from Prometheus-db1: only db1 runs these checks; db2 only stores a copy of the hosts' metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-db1"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-db1"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#0ca30c"
              },
              {
                "value": 1,
                "color": "#d03b3b"
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Prometheus up (db1 / db2) (db1)",
      "description": "Both Prometheus copies, as seen by db1. Always read from Prometheus-db1: only db1 runs these checks; db2 only stores a copy of the hosts' metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-db1"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-db1"
          },
          "expr": "up{job=~\"prometheus-db.*\"}",
          "legendFormat": "{{host}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d03b3b"
              },
              {
                "value": 1,
                "color": "#0ca30c"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#d03b3b"
                },
                "1": {
                  "text": "UP",
                  "color": "#0ca30c"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Hosts \u2014 now",
      "description": "One row per host. Disk = fullest real filesystem on that host (see 'Disk usage by mount').",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=\"nodeexporter\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "cpu",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "100 * (1 - max by (host) (node_memory_MemAvailable_bytes{job=\"nodeexporter\"}) / max by (host) (node_memory_MemTotal_bytes{job=\"nodeexporter\"}))",
          "legendFormat": "mem",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (host) (100 * (1 - node_filesystem_avail_bytes{job=\"nodeexporter\", fstype=~\"ext4|xfs|btrfs|zfs|ntfs\", mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{job=\"nodeexporter\", fstype=~\"ext4|xfs|btrfs|zfs|ntfs\", mountpoint!~\"/boot.*\"}))",
          "legendFormat": "disk",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (host) (node_load1{job=\"nodeexporter\"}) / count by (host) (node_cpu_seconds_total{job=\"nodeexporter\", mode=\"idle\"})",
          "legendFormat": "load",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count by (host) (node_cpu_seconds_total{job=\"nodeexporter\", mode=\"idle\"})",
          "legendFormat": "cores",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (host) (node_memory_MemTotal_bytes{job=\"nodeexporter\"})",
          "legendFormat": "ram",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "time() - max by (host) (node_boot_time_seconds{job=\"nodeexporter\"})",
          "legendFormat": "uptime",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            },
            "renameByName": {
              "host": "Host",
              "Value #A": "CPU busy",
              "Value #B": "Memory used",
              "Value #C": "Fullest disk",
              "Value #D": "Load / core",
              "Value #E": "Cores",
              "Value #F": "RAM",
              "Value #G": "Uptime"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
