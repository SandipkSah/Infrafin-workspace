      "id": 9,
      "type": "bargauge",
      "title": "Disk usage by mount (fullest first)",
      "description": "Real filesystems only (ext4/xfs), /boot excluded. Network mounts are shown on the host that owns the disk. HostDiskAlmostFull fires above 90 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sort_desc(100 * (1 - node_filesystem_avail_bytes{job=\"nodeexporter\", fstype=~\"ext4|xfs|btrfs|zfs|ntfs\", mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{job=\"nodeexporter\", fstype=~\"ext4|xfs|btrfs|zfs|ntfs\", mountpoint!~\"/boot.*\"}))",
          "legendFormat": "{{host}}  {{mountpoint}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
