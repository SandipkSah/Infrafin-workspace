    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Database sizes (top 12)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
