        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Connections by database (top 8)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (datname) (pg_stat_database_numbackends{database=\"$database\"}) and on (datname) topk(8, max_over_time(sum by (datname) (pg_stat_database_numbackends{database=\"$database\"})[$__range:1m] @ end()))",
          "legendFormat": "{{datname}}",
