    {
      "id": 3,
      "type": "stat",
      "title": "Network in (all hosts)",
      "description": "Physical network cards of all hosts together (cAdvisor host-level counters).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(sum by (host) (rate(container_network_receive_bytes_total{job=\"cadvisor\", id=\"/\", interface=~\"ens.*|eno.*|enp.*\"}[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
