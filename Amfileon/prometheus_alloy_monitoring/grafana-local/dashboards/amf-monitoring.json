    {
      "id": 9,
      "type": "timeseries",
      "title": "Notifications sent / failed (db1)",
      "description": "email = alerts to ALERT_EMAIL_TO; webhook = Watchdog heartbeat (once healthchecks.io is set up). Always read from Prometheus-db1: only db1 runs these checks; db2 only stores a copy of the hosts' metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-db1"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-db1"
          },
          "expr": "sum by (integration) (increase(alertmanager_notifications_total{job=\"alertmanager\", integration=~\"email|webhook\"}[$__rate_interval]))",
          "legendFormat": "sent \u00b7 {{integration}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-db1"
          },
          "expr": "sum by (integration) (increase(alertmanager_notifications_failed_total{job=\"alertmanager\", integration=~\"email|webhook\"}[$__rate_interval]))",
