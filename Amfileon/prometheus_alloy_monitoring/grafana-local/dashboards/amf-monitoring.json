          {
            "matcher": {
              "id": "byName",
              "options": "cpu1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu2"
            },
            "properties": [
              {
                "id": "color",
