{
  "uid": "amf-monitoring",
  "title": "Monitoring health",
  "description": "Is the monitoring itself healthy?",
  "tags": [
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "Prometheus-db.*",
        "current": {
          "text": "Prometheus-db1",
          "value": "prom-db1"
        },
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Firing alerts (db1)",
      "description": "Everything currently firing (the Watchdog heartbeat is hidden). Alerts are emailed by Alertmanager on db1. Always read from Prometheus-db1: only db1 runs these checks; db2 only stores a copy of the hosts' metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-db1"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-db1"
          },
          "expr": "ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true,
              "instance": true,
              "fstype": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "host": 2,
              "mountpoint": 3,
              "device": 4
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "host": "Host",
              "mountpoint": "Mount",
              "device": "Device"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "\u25cf critical",
                        "color": "#d03b3b"
                      },
                      "warning": {
                        "text": "\u25cf warning",
                        "color": "#fab219"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Prometheus (db1 & db2)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Samples ingested per second (db1)",
      "description": "db1 and db2 should track each other: every host pushes to both. Always read from Prometheus-db1: only db1 runs these checks; db2 only stores a copy of the hosts' metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-db1"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-db1"
          },
          "expr": "sum by (host) (rate(prometheus_tsdb_head_samples_appended_total{job=~\"prometheus-db.*\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "db1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "db2"
            },
            "properties": [
              {
                "id": "color",
